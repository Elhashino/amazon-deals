# Copy this file to .env and fill in what you have.
# Everything is optional — with no Telegram token the scanner prints alerts
# to the console instead.

# --- Telegram (see README for the 2-minute BotFather setup) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: free Helius API key = faster, more reliable bundle checks ---
# https://dev.helius.xyz  (free tier is plenty)
HELIUS_API_KEY=

# --- Tuning (defaults shown; uncomment to change) ---
# POLL_SECONDS=60
# MIN_LIQUIDITY_USD=20000
# MIN_PAIR_AGE_MINUTES=20
# MAX_PAIR_AGE_MINUTES=1440
# MAX_TOP10_HOLDER_PCT=30
# MAX_SINGLE_HOLDER_PCT=15
# MIN_LP_LOCKED_PCT=80
# MAX_INSIDER_PCT=25
# MAX_BUNDLE_PCT=20
# MAX_RUGCHECK_SCORE=40
# MIN_HOLDERS=100
# MIN_UNIQUE_BUYERS_H1=50
# MIN_ALERT_SCORE=60
# WATCH_HOURS=12
# RUG_LIQUIDITY_DROP_PCT=60
